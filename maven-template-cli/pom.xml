<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>fr.damnardev.template.maven</groupId>
		<artifactId>maven-template-internal-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../maven-template-internal-parent/pom.xml</relativePath>
	</parent>

	<artifactId>maven-template-cli</artifactId>
	<packaging>jar</packaging>

	<name>Maven Template - CLI</name>
	<description>Command-line interface for the Maven template</description>

	<dependencies>
		<dependency>
			<groupId>fr.damnardev.template.maven</groupId>
			<artifactId>maven-template-common</artifactId>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<mainClass>fr.damnardev.template.maven.cli.Startup</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
