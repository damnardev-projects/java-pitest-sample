<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>fr.damnardev.sample.pitest</groupId>
	<artifactId>pitest-sample-wrapper</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>Pitest Sample Wrapper</name>

	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>damnardev</id>
			<name>Damien</name>
			<email>admin@damnardev.fr</email>
		</developer>
	</developers>

	<scm>
		<url>https://github.com/damnardev-projects/java-pitest-sample</url>
		<connection>scm:git:git://github.com/damnardev-projects/java-pitest-sample.git</connection>
		<developerConnection>scm:git:git@github.com:damnardev-projects/java-pitest-sample.git</developerConnection>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<jacoco.maven.plugin.version>0.8.16</jacoco.maven.plugin.version>
		<maven.enforcer.plugin.version>3.7.0</maven.enforcer.plugin.version>
		<pitest.maven.plugin.version>1.30.0</pitest.maven.plugin.version>
		<pitest.junit5.version>1.2.3</pitest.junit5.version>
		<sonar.maven.plugin.version>5.8.0.7211</sonar.maven.plugin.version>
		<versions.maven.plugin.version>2.23.0</versions.maven.plugin.version>

		<sonar.projectKey>pitest-sample</sonar.projectKey>
		<sonar.projectName>Pitest Sample</sonar.projectName>
		<sonar.coverage.jacoco.xmlReportPaths>
			${maven.multiModuleProjectDirectory}/pitest-sample-tests/target/site/jacoco-aggregate/jacoco.xml
		</sonar.coverage.jacoco.xmlReportPaths>
		<sonar.coverage.exclusions>**/Startup.java</sonar.coverage.exclusions>
		<jacoco.excludes>**/generated/**,**/target/**</jacoco.excludes>
	</properties>

	<modules>
		<module>pitest-sample-dependencies</module>
		<module>pitest-sample-parent</module>
		<module>pitest-sample-internal-parent</module>
		<module>pitest-sample-common</module>
		<module>pitest-sample-cli</module>
		<module>pitest-sample-tests</module>
	</modules>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.jacoco</groupId>
					<artifactId>jacoco-maven-plugin</artifactId>
					<version>${jacoco.maven.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven.enforcer.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar.maven.plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>versions-maven-plugin</artifactId>
					<version>${versions.maven.plugin.version}</version>
					<configuration>
						<ignoredVersions>.*[-.]M\d+,.*-SNAPSHOT,.*[-.]alpha.*,.*[-.]beta.*</ignoredVersions>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.pitest</groupId>
					<artifactId>pitest-maven</artifactId>
					<version>${pitest.maven.plugin.version}</version>
					<dependencies>
						<dependency>
							<groupId>org.pitest</groupId>
							<artifactId>pitest-junit5-plugin</artifactId>
							<version>${pitest.junit5.version}</version>
						</dependency>
					</dependencies>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-maven</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<executions>
					<execution>
						<id>run-mutation-tests</id>
						<goals>
							<goal>mutationCoverage</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<targetClasses>
						<param>fr.damnardev.sample.pitest.*</param>
					</targetClasses>
					<targetTests>
						<param>fr.damnardev.sample.pitest.*</param>
					</targetTests>
					<mutators>
						<mutator>ALL</mutator>
					</mutators>
					<exportLineCoverage>true</exportLineCoverage>
					<outputFormats>
						<value>XML</value>
					</outputFormats>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
