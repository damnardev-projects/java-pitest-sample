<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>fr.damnardev.sample.pitest</groupId>
		<artifactId>pitest-sample-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pitest-sample-parent/pom.xml</relativePath>
	</parent>

	<artifactId>pitest-sample-internal-parent</artifactId>
	<packaging>pom</packaging>

	<name>Pitest Sample - Internal Parent</name>
	<description>Parent POM configuring the flatten-maven-plugin in OSSRH mode for children modules</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>flatten</id>
						<goals>
							<goal>flatten</goal>
						</goals>
						<phase>process-resources</phase>
					</execution>
					<execution>
						<id>clean</id>
						<goals>
							<goal>clean</goal>
						</goals>
						<phase>clean</phase>
					</execution>
				</executions>
				<configuration>
					<flattenMode>ossrh</flattenMode>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
